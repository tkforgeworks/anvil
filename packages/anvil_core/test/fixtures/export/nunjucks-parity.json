{
  "guide.example_verbatim": {
    "source": "# {{ project.game_title }} - Items\n\n{% for item in items %}\n## {{ item.display_name }} ({{ item.export_key }})\nCategory: {{ item.item_category_id | export_key }}\nRarity: {{ item.rarity_id | export_key }}\n{{ item.description }}\n\n{% endfor %}",
